---
// The kinds of machine, drawn as About This Server draws them in the app
// (src/components/DeviceArt.tsx), plus a TV box.
interface Props {
  kind: 'virtual' | 'server' | 'mini' | 'laptop' | 'board' | 'stb'
  size?: number
}
const { kind, size = 150 } = Astro.props
---

<svg class="device-art" width={size} height={size * 0.72} viewBox="0 0 120 86" aria-hidden="true">
  <defs>
    <linearGradient id="da-case" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a3d44"></stop><stop offset="1" stop-color="#202226"></stop></linearGradient>
    <linearGradient id="da-metal" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d9dde3"></stop><stop offset="1" stop-color="#9aa1ab"></stop></linearGradient>
    <linearGradient id="da-screen" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5ac8fa"></stop><stop offset="1" stop-color="#0a63d6"></stop></linearGradient>
    <linearGradient id="da-cloud" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7cc4ff"></stop><stop offset="1" stop-color="#2f7cf6"></stop></linearGradient>
  </defs>
  <ellipse cx="60" cy="78" rx="46" ry="4" fill="rgba(0,0,0,0.16)"></ellipse>
  {
    kind === 'virtual' && (
      <g>
        <path d="M36 62a16 16 0 0 1 2-31.8A22 22 0 0 1 80 26a18 18 0 0 1 4 36z" fill="url(#da-cloud)" />
        <rect x="44" y="38" width="32" height="9" rx="2" fill="rgba(255,255,255,0.9)" />
        <rect x="44" y="49" width="32" height="9" rx="2" fill="rgba(255,255,255,0.9)" />
        <circle cx="49" cy="42.5" r="1.4" fill="#30d158" />
        <circle cx="49" cy="53.5" r="1.4" fill="#30d158" />
      </g>
    )
  }
  {
    kind === 'server' &&
      [18, 36, 54].map(y => (
        <g>
          <rect x="14" y={y} width="92" height="16" rx="2" fill="url(#da-case)" />
          <circle cx="22" cy={y + 8} r="1.6" fill="#30d158" />
          {[34, 46, 58, 70].map(x => (
            <rect x={x} y={y + 5} width="9" height="6" rx="1" fill="rgba(255,255,255,0.1)" />
          ))}
          <rect x="86" y={y + 6} width="14" height="4" rx="1" fill="rgba(255,255,255,0.12)" />
        </g>
      ))
  }
  {
    kind === 'mini' && (
      <g>
        <path d="M18 34h76l12-10H30z" fill="#4a4e57" />
        <path d="M94 34l12-10v30l-12 10z" fill="#1d1f23" />
        <rect x="18" y="34" width="76" height="30" rx="2" fill="url(#da-case)" />
        <circle cx="28" cy="49" r="3.2" fill="none" stroke="#9ba3ad" stroke-width="1.2" />
        <circle cx="28" cy="49" r="1" fill="#30d158" />
        <rect x="38" y="45" width="7" height="3" rx="0.6" fill="#9ba3ad" />
        <rect x="38" y="51" width="7" height="3" rx="0.6" fill="#9ba3ad" />
        <circle cx="51" cy="49.5" r="1.6" fill="#9ba3ad" />
        {[62, 66, 70, 74, 78, 82, 86].map(x => (
          <rect x={x} y="40" width="1.4" height="18" rx="0.7" fill="rgba(255,255,255,0.08)" />
        ))}
      </g>
    )
  }
  {
    kind === 'laptop' && (
      <g>
        <rect x="24" y="14" width="72" height="50" rx="4" fill="#2b2d33" />
        <rect x="28" y="18" width="64" height="42" rx="1.5" fill="url(#da-screen)" />
        <path d="M12 66h96l-6 8H18z" fill="url(#da-metal)" />
        <rect x="52" y="66" width="16" height="2" rx="1" fill="rgba(0,0,0,0.18)" />
      </g>
    )
  }
  {
    kind === 'board' && (
      <g>
        <rect x="16" y="20" width="88" height="54" rx="4" fill="#1f8a4c" />
        <rect x="44" y="34" width="22" height="22" rx="2" fill="#2b2d33" />
        <rect x="22" y="24" width="60" height="4" rx="1" fill="#d4af37" />
        <rect x="86" y="30" width="14" height="12" rx="1" fill="#c7ccd4" />
        <rect x="86" y="48" width="14" height="12" rx="1" fill="#c7ccd4" />
        <rect x="24" y="62" width="10" height="8" rx="1" fill="#c7ccd4" />
      </g>
    )
  }
  {
    kind === 'stb' && (
      <g>
        {/* A small square TV box, and its remote. */}
        <path d="M22 44h52l10-9H32z" fill="#3b3e45" />
        <path d="M74 44l10-9v20l-10 9z" fill="#15161a" />
        <rect x="22" y="44" width="52" height="20" rx="3" fill="url(#da-case)" />
        <circle cx="30" cy="54" r="1.3" fill="#0a84ff" />
        <rect x="40" y="52.5" width="20" height="3" rx="1.5" fill="rgba(255,255,255,0.1)" />
        <rect x="90" y="30" width="12" height="40" rx="6" fill="#26282d" />
        <circle cx="96" cy="38" r="3" fill="none" stroke="#9ba3ad" stroke-width="1.1" />
        <circle cx="96" cy="38" r="1" fill="#9ba3ad" />
        <rect x="93" y="46" width="6" height="2" rx="1" fill="#9ba3ad" />
        <rect x="93" y="51" width="6" height="2" rx="1" fill="#9ba3ad" />
        <circle cx="96" cy="60" r="1.4" fill="#ff453a" />
      </g>
    )
  }
</svg>
